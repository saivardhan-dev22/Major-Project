# PORT: Server listening port (default: 3000 for Vite/dev server)
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string (or local mongodb://localhost:27017/docvision)
# Required for persistent production storage and Atlas Vector Search
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/docvision?retryWrites=true&w=majority"

# GROQ_API_KEY: Groq API Key for high-speed LLM structured extraction and RAG
GROQ_API_KEY="gsk_your_groq_api_key_here"

# GROQ_MODEL: Configurable Groq Model identifier (never hardcoded)
GROQ_MODEL="llama-3.3-70b-versatile"

# JWT_SECRET: Strong secret for signing and verifying JSON Web Tokens
JWT_SECRET="docvision-enterprise-super-secret-production-key-2026"
JWT_EXPIRES_IN="24h"

# PYTHON_SERVICE_URL: URL of the Python FastAPI microservice (PyMuPDF, EasyOCR, all-MiniLM-L6-v2)
PYTHON_SERVICE_URL="http://localhost:8000"

# EMBEDDING_MODEL: Local Hugging Face sentence-transformers model
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

